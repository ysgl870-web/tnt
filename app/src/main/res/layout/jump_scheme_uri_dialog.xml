<?xml version="1.0" encoding="utf-8"?>
<moe.ono.ui.view.RadiusCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pb_sender_root_cardview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rcv_topLeftRadiu="20dp"
    app:rcv_topRightRadiu="20dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scheme / URL 转换跳板"
            android:textColor="@color/firstTextColor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="网页 URL 可封装为 Android Intent Scheme；支持还原 Intent Scheme、解析 QQ Scheme 和安全跳转"
            android:textColor="@color/secondTextColor"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/scheme_uri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top|start"
            android:hint="粘贴 Scheme 或 URL（mqqapi://、https://、intent://…）"
            android:inputType="textUri|textMultiLine"
            android:minHeight="84dp"
            android:padding="12dp"
            android:textColor="@color/firstTextColor"
            android:textColorHint="@color/secondTextColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_analyze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="解析 / 转换"
                android:textColor="@color/white"
                app:backgroundTint="#1976D2"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_jump"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="跳板打开"
                android:textColor="@color/white"
                app:backgroundTint="#00897B"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="复制转换结果"
            android:textColor="@color/firstTextColor"
            app:backgroundTint="@color/mask_bg"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="转换输出"
            android:textColor="@color/firstTextColor"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/scheme_converted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mask_bg"
            android:padding="10dp"
            android:text="转换后的链接会显示在这里"
            android:textColor="@color/firstTextColor"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/mask_bg" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/scheme_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="解析详情会显示在这里。普通网页 URL 可以转换为 Android Intent Scheme，但不能凭空转换为通用 QQ mqqapi Scheme。"
                android:textColor="@color/firstTextColor"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </ScrollView>
    </LinearLayout>
</moe.ono.ui.view.RadiusCardView>
